# TaskFlow local development configuration
# Copy this file to .env and replace all sample secrets before running.

# Optional SQLite is the easiest local option and requires no separate database server.
# Uncomment the following line to use SQLite
# DATABASE_URL=sqlite:///./todo_app.db
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/taskflow

# Generate a unique secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5500

# Initial Master Admin created by init_db.py. Set a strong password.
MASTER_ADMIN_EMAIL=masteradmin@example.com
MASTER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional sample accounts and sample tasks for classroom demos.
SEED_DEMO_ACCOUNTS=false
DEMO_USER_EMAIL=testuser1@mail.com
DEMO_USER_PASSWORD=
DEMO_ADMIN_EMAIL=testadmin1@mail.com
DEMO_ADMIN_PASSWORD=

# Optional email delivery for admin request notifications and verification codes.
# If SMTP is not configured, Master Admin can copy the code from the approval screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
