DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/todo_app

# REQUIRED. Long random string (32+ chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Set to "production" to hide /docs
APP_ENV=development

# Optional: creates the FIRST admin on startup if that email doesn't exist yet.
# Remove the password from .env after the first run.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
